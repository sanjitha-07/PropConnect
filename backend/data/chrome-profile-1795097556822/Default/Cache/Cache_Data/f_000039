export const propertyById = (id) => {
  const p = PROPERTIES.find((item) => item.id === id);
  if (!p) return null;
  const images = (p.images && p.images.length > 0) ? p.images : generateGalleryForProperty(p);
  return {
    ...p,
    images,
  };
};
