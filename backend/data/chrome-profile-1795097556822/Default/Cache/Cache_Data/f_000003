t-weight: 700;\r\n  color: var(--ink-primary);\r\n}\r\n\r\n.sync-info-subtitle {\r\n  font-size: 12px;\r\n  color: var(--ink-muted);\r\n}\r\n\r\n/* ==========================================================================\r\n   FEATURE 1 — TENANT DISCOVERY & PREFERENCE FLOW STYLES\r\n   Visual Identity: White, Deep Blue, Charcoal, Subtle Grey\r\n   ========================================================================== */\r\n\r\n.preference-flow-wrapper {\r\n  max-width: 900px;\r\n  margin: 0 auto 30px auto;\r\n}\r\n\r\n.preference-card {\r\n  padding: 32px;\r\n  border-radius: var(--radius-xl);\r\n  box-shadow: var(--shadow-lg);\r\n  border: 1px solid var(--border-subtle);\r\n  background: #ffffff;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.pref-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.pref-step-pill {\r\n  display: inline-block;\r\n  padding: 4px 12px;\r\n  background: var(--brand-blue-subtle);\r\n  color: var(--brand-blue);\r\n  font-size: 12px;\r\n  font-weight: 700;\r\n  border-radius: var(--radius-full);\r\n  margin-bottom: 10px;\r\n  letter-spacing: 0.5px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.pref-title {\r\n  font-size: 24px;\r\n  font-weight: 800;\r\n  color: var(--ink-primary);\r\n  margin: 0 0 6px 0;\r\n  line-height: 1.25;\r\n}\r\n\r\n.pref-subtitle {\r\n  font-size: 14px;\r\n  color: var(--ink-muted);\r\n  margin: 0;\r\n}\r\n\r\n.pref-close-btn {\r\n  background: var(--bg-subtle);\r\n  border: 1px solid var(--border-subtle);\r\n  color: var(--ink-secondary);\r\n  font-size: 16px;\r\n  width: 34px;\r\n  height: 34px;\r\n  border-radius: var(--radius-full);\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.pref-close-btn:hover {\r\n  background: var(--red-bg);\r\n  color: var(--red);\r\n  border-color: var(--red-border);\r\n}\r\n\r\n.pref-progress-bar {\r\n  width: 100%;\r\n  height: 6px;\r\n  background: var(--bg-subtle);\r\n  border-radius: 999px;\r\n  margin-bottom: 28px;\r\n  overflow: hidden;\r\n}\r\n\r\n.pref-progress-fill {\r\n  height: 100%;\r\n  background: linear-gradient(90deg, var(--brand-blue) 0%, #3b82f6 100%);\r\n  border-radius: 999px;\r\n  transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n.pref-step-body {\r\n  min-height: 320px;\r\n}\r\n\r\n.pref-field-label {\r\n  display: block;\r\n  font-size: 14.5px;\r\n  font-weight: 700;\r\n  color: var(--ink-primary);\r\n  margin-bottom: 12px;\r\n}\r\n\r\n/* Chip Grid */\r\n.chip-grid {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 10px;\r\n}\r\n\r\n.pref-chip {\r\n  background: var(--bg-subtle);\r\n  border: 1px solid var(--border-subtle);\r\n  color: var(--ink-secondary);\r\n  padding: 10px 18px;\r\n  border-radius: var(--radius-lg);\r\n  font-size: 13.5px;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.pref-chip:hover {\r\n  border-color: var(--accent-primary);\r\n  color: var(--accent-primary);\r\n  background: #ffffff;\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.pref-chip.selected {\r\n  background: var(--brand-blue);\r\n  color: #ffffff;\r\n  border-color: var(--brand-blue);\r\n  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);\r\n}\r\n\r\n.pref-chip.selected .chip-pin {\r\n  filter: brightness(2);\r\n}\r\n\r\n/* Option Cards (Property Types) */\r\n.option-cards-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\r\n  gap: 12px;\r\n}\r\n\r\n.option-card {\r\n  border: 1.5px solid var(--border-subtle);\r\n  background: #ffffff;\r\n  border-radius: var(--radius-lg);\r\n  padding: 18px 14px;\r\n  text-align: center;\r\n  cursor: pointer;\r\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n.option-card:hover {\r\n  border-color: var(--brand-blue);\r\n  tr